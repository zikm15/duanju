# 正式模式请使用至少 16 位随机管理密码。不要把真实 .env 提交到 Git。
# 服务器读取进程环境；若使用此文件，请通过 node --env-file=.env server/index.js 启动。
PORT=3000
NODE_ENV=production
DEMO_MODE=false
ADMIN_PASSWORD=
# 仅在部署平台的可信反向代理后设置为 1，本机开发保持 0。
TRUST_PROXY_HOPS=0
# 可选：持久数据与上传文件目录。默认 /workspace/duanju/.runtime
# DATA_DIR=/workspace/duanju/.runtime
# PayPal 当前未开通；此版本不读取或发送支付凭据。
